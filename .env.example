# FOLAX DTC — Configuración del servidor
# Copia este archivo como .env y edita los valores
# El gateway lo carga automáticamente al iniciar.

# ── Ollama ──────────────────────────────────────────────────────────────────
# URL base de Ollama (cambiar si Ollama corre en otro equipo)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── API / CORS ───────────────────────────────────────────────────────────────
# Orígenes CORS permitidos (* = todos, o lista separada por comas)
ALLOWED_ORIGINS=*

# ── Rate limiting ────────────────────────────────────────────────────────────
# Requests máximos por API key por minuto
RATE_LIMIT_PER_MIN=120

# Intentos de login fallidos antes de bloquear la IP
AUTH_RATE_LIMIT=5

# Minutos de bloqueo tras superar intentos fallidos
AUTH_BLOCK_MINUTES=15

# ── Admin ────────────────────────────────────────────────────────────────────
# Token para proteger acciones administrativas (dejar vacío para desactivar)
ADMIN_TOKEN=

# Días hasta expiración de API keys
KEY_EXPIRY_DAYS=90

# Horas hasta expiración de sesión inactiva
SESSION_EXPIRY_HOURS=24

# ── Base de Datos ────────────────────────────────────────────────────────────
# backend de base de datos: sqlite | mysql
DB_BACKEND=sqlite
# Credenciales para MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=folax_dtc
MYSQL_POOL_SIZE=5
